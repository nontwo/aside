{
  "manifest_version": 3,
  "name": "Aside",
  "description": "Ask focused follow-up questions from long ChatGPT and Claude answers without losing your place.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "assets/root-content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Aside",
    "default_popup": "popup.html"
  }
}
